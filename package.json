    "test:render": "node tools/test_render.js",
    "serve": "python3 -m http.server 8000 --directory dist"
  },
  "devDependencies": {
    "canvas": "^2.11.2",
    "polygon-clipping": "0.15.7",
    "jspdf": "2.5.2"
  }
}
