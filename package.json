{
  "name": "stirling-suburb-groups",
  "version": "0.3.0",
  "private": true,
  "description": "Suburb grouping map viewer for the City of Stirling, Western Australia",
  "scripts": {
    "build": "python3 tools/assemble.py",
    "data": "python3 tools/build_data.py",
